# Required. Admission HMAC secret with at least 32 UTF-8 bytes.
# Generate and store the real value outside source control.
ADMISSION_HMAC_SECRET=

# Optional comma-separated IPv4/IPv6 CIDRs for trusted reverse proxies.
# Leave empty when the application receives client connections directly.
TRUSTED_PROXY_CIDRS=

# Comma-separated origins allowed by CORS (backend). Default: http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Supabase backend credentials.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Groq API keys used by the engine (at least one required).
GROQ_API_KEY=
GROQ_API_KEY_2=

# Optional: enable archival extraction (valid values: true/false).
ARCHIVAL_EXTRACTION_ENABLED=false

# Frontend build-time variables (docker-compose build args).
# The browser needs the public API URL and the public Supabase URL/anon key.
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
